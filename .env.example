# API server
PORT=3001
NODE_ENV=development

# Bootstrap one administrator on first startup. Set both values before starting the API.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=UnFocus Admin

# Public host port for Docker Compose. Change it if port 3001 is already in use.
APP_PORT=3001

# Leave empty to use secure cookies in production. Set false only for HTTP localhost testing.
COOKIE_SECURE=

# Optional fixed USD/ARS rate. When empty, the API reads DolarAPI's official selling quote.
USD_ARS_RATE=

# Mercado Pago credentials. Required to activate online checkout.
MP_ACCESS_TOKEN=
MP_ENVIRONMENT=test
PUBLIC_BASE_URL=https://unfocus.shop
# Optional HTTPS return URL for checkout testing. Defaults to PUBLIC_BASE_URL.
MP_RETURN_URL=
# Optional public webhook URL, e.g. a development tunnel.
MP_WEBHOOK_URL=
MP_WEBHOOK_SECRET=
PENDING_ORDER_EXPIRY_DAYS=3

# ---------------------------------------------------------------------------
# Correo Argentino (API Paq.ar). Las credenciales las entrega el área Comercial
# de Correo Argentino. Sin ellas, el botón "Generar envío" no aparece en el admin.
# ---------------------------------------------------------------------------
# Obligatorias: credenciales
CORREO_ARGENTINO_API_KEY=
CORREO_ARGENTINO_AGREEMENT=
# test = https://apitest.correoargentino.com.ar | production = https://api.correoargentino.com.ar
CORREO_ARGENTINO_ENVIRONMENT=test
# Opcional: sobrescribe la URL base completa (incluye /paqar/v1)
CORREO_ARGENTINO_BASE_URL=
# Tipo de servicio (2 letras, p. ej. CP = clásico). Confirmar el valor con tu ejecutivo de cuenta.
CORREO_SERVICE_TYPE=CP
# Obligatorios: datos del remitente (tu tienda). La provincia es el CÓDIGO (B = Buenos Aires, C = CABA, X = Córdoba, S = Santa Fe...).
CORREO_SENDER_NAME=
CORREO_SENDER_EMAIL=
CORREO_SENDER_AREA_CODE=
CORREO_SENDER_PHONE=
CORREO_SENDER_STREET=
CORREO_SENDER_STREET_NUMBER=
CORREO_SENDER_FLOOR=
CORREO_SENDER_DEPARTMENT=
CORREO_SENDER_CITY=
CORREO_SENDER_PROVINCE_CODE=
CORREO_SENDER_ZIP_CODE=
# Paquete estándar (la API toma un solo bulto): peso en gramos y medidas en cm (máx. 3 dígitos).
CORREO_PARCEL_WEIGHT_GRAMS=400
CORREO_PARCEL_HEIGHT_CM=5
CORREO_PARCEL_WIDTH_CM=25
CORREO_PARCEL_DEPTH_CM=35
CORREO_PARCEL_CATEGORY=Indumentaria

# Contact form email delivery (messages are also stored for admin if SMTP is not configured).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional SQLite database path. Defaults to ./data/unfocus.sqlite.
DATABASE_PATH=

# Store details (initial values; editable later from the admin panel, where they are stored in the database).
SHIPPING_COST_ARS=0
FREE_SHIPPING_THRESHOLD_ARS=0
PICKUP_ADDRESS=
STORE_LEGAL_NAME=
STORE_TAX_ID=
STORE_ADDRESS=
STORE_EMAIL=
STORE_PHONE=

# Optional persistent folders (hosting without persistent project folder). Default: ./uploads and ./ident
UPLOAD_DIR=
IDENT_DIR=
